# Copy this file to .env and fill in your Firebase project's config.
#
# 1. Go to https://console.firebase.google.com and create a project
#    (free tier is plenty for this).
# 2. In Project settings > General > Your apps, add a Web app.
#    Firebase will show you a config object - copy the values below.
# 3. In Build > Authentication > Sign-in method, enable "Email/Password".
# 4. In Build > Firestore Database, click "Create database" (start in
#    test mode for local dev, then apply firestore.rules before you
#    deploy for real - see README).
#
# Photos are compressed and stored directly inside each letter's
# Firestore document (as base64), so Firebase Storage isn't used and
# you don't need the paid Blaze plan for this app.

VITE_FIREBASE_API_KEY= AIzaSyApf07TXQscojK_zoY4bK1xE_nH5Skrp48
VITE_FIREBASE_AUTH_DOMAIN=bunnysendletters.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bunnysendletters
VITE_FIREBASE_MESSAGING_SENDER_ID=388607619458
VITE_FIREBASE_APP_ID=1:388607619458:web:4dd0f2fdf925f98cc4df9b
